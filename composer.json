{
    "name": "kirimi/laravel-kirimi",
    "description": "Official Laravel package for the Kirimi WhatsApp API — Facade, Notification channel, and Artisan commands.",
    "keywords": ["kirimi", "laravel", "whatsapp", "whatsapp-api", "otp", "notification", "indonesia"],
    "homepage": "https://github.com/kiriminow/kirimi-laravel",
    "license": "MIT",
    "authors": [
        { "name": "Kirimi", "email": "support@kirimi.id" }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "kirimi/kirimi-php": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kirimi\\Laravel\\": "src/"
        },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Kirimi\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Kirimi\\Laravel\\KirimiServiceProvider"],
            "aliases": { "Kirimi": "Kirimi\\Laravel\\Facades\\Kirimi" }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
